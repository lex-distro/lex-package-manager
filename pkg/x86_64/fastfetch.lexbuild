{
  "kind": "recipe",
  "name": "fastfetch",
  "version": "2.68.1",
  "arch": ["x86_64"],
  "deps": [],
  "homepage": "https://github.com/fastfetch-cli/fastfetch",
  "description": "A maintained, feature-rich and performance oriented, neofetch like system information tool.",
  "binary": {
    "url": "https://github.com/fastfetch-cli/fastfetch/releases/download/2.68.1/fastfetch-linux-amd64.tar.gz",
    "sha256": "0c51ef6fa3e976eb5038fe0afda38629d3ca07947740bb0e3354c7c4f1238c0c",
    "install": [
      "mkdir -p $DESTDIR/usr/bin $DESTDIR/usr/share",
      "cp -a fastfetch-linux-amd64/usr/bin/fastfetch $DESTDIR/usr/bin/fastfetch",
      "cp -a fastfetch-linux-amd64/usr/bin/flashfetch $DESTDIR/usr/bin/flashfetch",
      "cp -a fastfetch-linux-amd64/usr/share/fastfetch $DESTDIR/usr/share/fastfetch"
    ]
  },
  "source": {
    "url": "https://github.com/fastfetch-cli/fastfetch/archive/refs/tags/2.68.1.tar.gz",
    "sha256": "c268cfcd230cc7ed5447fb34ed21bf4977315c7104356a39388b6ba784ad11b0",
    "build": ["cmake -B build -DCMAKE_BUILD_TYPE=Release", "cmake --build build"],
    "install": ["DESTDIR=$DESTDIR cmake --install build"],
    "post_remove": ["ldconfig"]
  },
  "post_remove": ["ldconfig"]
}
